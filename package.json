{
  "name": "kndl000",
  "version": "1.0.0",
  "description": "Bitácora KNDL 000 — blog minimalista en Jekyll con CMS propio.",
  "private": true,
  "scripts": {
    "build": "bundle exec jekyll build",
    "serve": "bundle exec jekyll serve",
    "build:rizoma": "bash scripts/build-rizoma.sh",
    "serve:rizoma": "bash scripts/build-rizoma.sh && bundle exec jekyll serve --skip-initial-build",
    "clean": "rm -rf _site .jekyll-cache .sass-cache",
    "umbral:update": "git submodule update --remote assets/js/umbral-vision",
    "test:taller": "node --test taller/tests/*.test.mjs"
  },
  "dependencies": {
    "@kndl/umbral-vision": "^0.1.0"
  },
  "keywords": [],
  "author": "KNDL",
  "license": "ISC"
}
